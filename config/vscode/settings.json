{
  // ======================================================
  // Editor - Appearance
  // ======================================================

  // font family
  // "editor.fontFamily": "'Inconsolata-g', 'monospace', monospace, 'Droid Sans Fallback'ZZ",
  "editor.fontFamily": "InconsolataLGC Nerd Font",
  "editor.fontSize": 12,
  "editor.fontWeight": "500",
  "editor.lineHeight": 20,
  "editor.letterSpacing": 0,

  "terminal.integrated.fontFamily": "InconsolataLGC Nerd Font",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.lineHeight": 1.0,
  "terminal.integrated.gpuAcceleration": "on",

  "terminal.integrated.letterSpacing": 0.5,

  "editor.cursorBlinking": "expand",
  "editor.renderLineHighlight": "all",

  "editor.minimap.enabled": false,
  "editor.linkedEditing": true,
  "editor.occurrencesHighlight": "off",

  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",

  "editor.acceptSuggestionOnEnter": "off",

  "editor.quickSuggestions": {
    "strings": true
  },

  "editor.smoothScrolling": true,

  "editor.guides.indentation": false,
  "editor.glyphMargin": false,

  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerLanes": 0,

  "editor.lineNumbers": "relative",

  "editor.renderWhitespace": "none",
  "editor.matchBrackets": "never",

  "editor.parameterHints.enabled": false,

  "editor.codeLens": false,
  "editor.lightbulb.enabled": "off",

  "editor.bracketPairColorization.enabled": false,
  "editor.guides.bracketPairs": false,

  "editor.stickyScroll.enabled": false,
  "editor.folding": false,

  // ======================================================
  // Editor - Formatting & Indentation
  // ======================================================

  "editor.tabSize": 2,
  "editor.detectIndentation": false,

  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "files.trimFinalNewlines": true,

  "editor.hover.enabled": "on",

  "[python]": {
    "editor.tabSize": 4
  },

  "[java]": {
  "editor.tabSize": 4
  },

  // ======================================================
  // Window & Workbench
  // ======================================================

  "window.zoomLevel": 0.65,
  "window.restoreWindows": "none",
  "window.commandCenter": false,

  "workbench.startupEditor": "none",
  // "workbench.statusBar.visible": false,

  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "top",
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  "workbench.iconTheme": "material-icon-theme",
  "workbench.settings.useSplitJSON": true,

  "workbench.editor.enablePreview": false,
  "workbench.tips.enabled": false,

  "breadcrumbs.enabled": false,

  // ======================================================
  // Explorer - Minimal Folder Tree
  // ======================================================

  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,

  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 10,

  // ======================================================
  // Files
  // ======================================================

  "files.autoSave": "afterDelay",

  // ======================================================
  // Diff & Git
  // ======================================================

  "diffEditor.wordWrap": "on",
  "scm.diffDecorations": "none",

  "problems.decorations.enabled": false,

  // ======================================================
  // Theme & UI Customization
  // ======================================================

  "workbench.colorCustomizations": {
    "terminalCursor.foreground": "#ffff00"
  },

  "glassit.alpha": 250,
  "glassit-linux.opacity": 95,

  // ======================================================
  // Terminal
  // ======================================================

  "terminal.integrated.fontFamily": "monospace",
  "terminal.integrated.tabs.enabled": false,

  // ======================================================
  // Tailwind & CSS
  // ======================================================

  "css.validate": false,

  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript",
    "css": "css"
  },

  // ======================================================
  // Vim
  // ======================================================

  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,

  "vim.useCtrlKeys": true,
  "vim.useSystemClipboard": true,

  "vim.smartRelativeLine": true,

  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    }
  ],

  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "d"],
      "after": ["d", "d"]
    },
    {
      "before": ["<C-n>"],
      "commands": [":nohl"]
    }
  ],

  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false
  },

  // ======================================================
  // TypeScript
  // ======================================================

  "typescript.updateImportsOnFileMove.enabled": "always",

  // ======================================================
  // Extensions & Telemetry
  // ======================================================

  "extensions.ignoreRecommendations": true,
  "redhat.telemetry.enabled": false,
  "chat.viewSessions.enabled": false,

  // ======================================================
  // Dev Containers
  // ======================================================

  "dev.containers.dockerPath": "podman",

  // ======================================================
  // Updates
  // ======================================================

  "update.showReleaseNotes": false,

  // ======================================================
  // ULTRA MINIMAL ZEN MODE
  // ======================================================

  "zenMode.fullScreen": true,
  "zenMode.centerLayout": true,
  "zenMode.hideActivityBar": true,
  "zenMode.hideStatusBar": true,
  "zenMode.hideLineNumbers": false,
  "zenMode.restore": true,
  "zenMode.silentNotifications": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": false,
    "scminput": false
  },
}